  "item": [
    {
      "name": "Get all users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "users"
          ]
        },
        "description": "Wylistowanie pełnych informacji o wszystkich użytkownikach."
      },
      "response": []
    },
    {
      "name": "Get all simple users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/simple",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "users",
            "simple"
          ]
        },
        "description": "Wylistowanie podstawowych informacji (ID + imię i nazwisko)."
      },
      "response": []
    },
    {
      "name": "Get user by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "users",
            "{{userId}}"
          ]
        },
        "description": "Pobranie szczegółów wybranego użytkownika po ID."
      },
      "response": []
    },
    {
      "name": "Search users by email",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/email?email=domain.com",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "users",
            "email"
          ],
          "query": [
            {
              "key": "email",
              "value": "domain.com"
            }
          ]
        },
        "description": "Wyszukiwanie po fragmencie e-maila, bez rozróżniania wielkości liter (zwraca ID + e-mail)."
      },
      "response": []
    },
    {
      "name": "Get users older than",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/older/2000-01-01",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "users",
            "older",
            "2000-01-01"
          ]
        },
        "description": "Wyszukiwanie użytkowników starszych niż podana data (birthdate przed datą)."
      },
      "response": []
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstName\": \"Mike\",\n    \"lastName\": \"Scott\",\n    \"birthdate\": \"1999-09-29\",\n    \"email\": \"mike.scott@domain.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v1/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v1",
            "users"
          ]
        },
        "description": "Utworzenie nowego użytkownika (201 Created)."
      },
      "response": []
    },
    {
